NODE_ENV=development
PORT=3000
DEFAULT_TIMEOUT_MS=15000

# Security
API_KEY_SECRET=change-me-in-production-1234
WEBHOOK_SIGNING_SECRET=change-me-too-1234

# Budgeting / throttling
TENANT_RATE_LIMIT_PER_MIN=60
PROVIDER_RATE_LIMIT_PER_MIN=600
MONTHLY_BUDGET_USD=25

# Cache
REDIS_URL=redis://localhost:6379
SQLITE_PATH=edge-cache.db

# Providers
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=
REPLICATE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct

# Feature flags
FEATURE_USE_EDGE_CACHE=true
FEATURE_ENABLE_FAILOVER=true
